{
  "expo": {
    "name": "Fun Travels Tour",
    "slug": "fun-travels-tour-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.funtravelstour.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.funtravelstour.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Fun Travels Tour to use your photos for your profile picture.",
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "scheme": "funtravelstour",
    "extra": {
      "apiUrl": "https://fun-travels-tour-api.onrender.com",
      "eas": {
        "projectId": "5904cbe2-b775-4ca0-a62f-536746ddbe68"
      }
    },
    "owner": "hussain_al_aradi"
  }
}
